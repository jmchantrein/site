{
  "name": "iadmin",
  "version": "0.1.0",
  "description": "IAdmin — cours et articles sur l'administration système, l'automatisation et l'intelligence artificielle.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run prepare:vm && astro build",
    "check": "npm run check:content && npm run test:terminal && npm run test:vm && npm run build && npm run test:smoke",
    "check:content": "node scripts/check-content.mjs",
    "test:smoke": "node --test scripts/smoke-built-site.test.mjs",
    "test:terminal": "python3 scripts/test-terminal-companion.py",
    "test:vm": "npm run prepare:vm && node scripts/test-vm-assets.mjs && node scripts/test-vm-boot.mjs",
    "prepare:vm": "node scripts/prepare-vm-assets.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/atkinson-hyperlegible": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/opendyslexic": "^5.2.5",
    "@fontsource/public-sans": "^5.2.7",
    "@fontsource/source-serif-4": "^5.2.9",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "astro": "^6.4.5",
    "katex": "^0.17.0",
    "lucide-static": "^1.17.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "v86": "^0.5.462"
  }
}
