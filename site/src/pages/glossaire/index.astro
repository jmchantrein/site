---
import Reading from "../../layouts/Reading.astro";
import { getCollection } from "astro:content";
import VideoEmbed from "../../components/VideoEmbed.astro";
import { GLOSSAIRE } from "../../data/glossaire.mjs";
import { contentResources } from "../../lib/content-index.mjs";

/* INDEX DU GLOSSAIRE — termes techniques, anglicismes et personnages des
   sciences, générés depuis la source unique (src/data/glossaire.mjs).
   Dans les cours, ces entrées sont auto-liées : survol = définition brève,
   clic = la fiche. */
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const coll = new Intl.Collator("fr");
const termes = GLOSSAIRE.filter((e) => e.type === "terme").sort((a, b) => coll.compare(a.fr, b.fr));
const personnages = GLOSSAIRE.filter((e) => e.type === "personnage").sort((a, b) =>
  coll.compare(a.fr.split(" ").at(-1) ?? a.fr, b.fr.split(" ").at(-1) ?? b.fr),
);
const contenus = await getCollection("cours", ({ id, data }) => !id.startsWith("en/") && !data.draft);
const articles = await getCollection("miscelanea", ({ id, data }) => !id.startsWith("en/") && !data.draft);
const ressources = contentResources([...contenus, ...articles]);
---
<Reading
  title="Glossaire"
  description="Termes techniques, anglicismes et personnages des sciences : les définitions brèves qui maillent tous les cours du site."
  crumb={{ href: `${base}/`, label: "accueil" }}
  lead="Chaque entrée maille les cours : au fil de la lecture, la première occurrence d'un terme est soulignée — survol pour la définition brève, clic pour la fiche. Les anglicismes portent leur correspondance français ↔ anglais."
  locale="fr"
  altUrl={`${base}/en/glossaire/`}
>
  <nav class="gloss-nav" aria-label="Sections du glossaire">
    <a href="#termes">Termes</a><a href="#personnages">Personnages</a><a href="#videos">Vidéos</a><a href="#ressources">Ressources externes</a>
  </nav>
  <h2 id="termes">Termes techniques</h2>
  <ul class="gloss-index">
    {termes.map((e) => (
      <li>
        <a href={`${base}/glossaire/${e.slug}/`}>{e.fr}</a>
        {e.angl && <em> (en&nbsp;: {e.en})</em>}
        {!e.angl && e.en.toLowerCase() !== e.fr.toLowerCase() && <em> · en&nbsp;: {e.en}</em>}
        — {e.brefFr}
      </li>
    ))}
  </ul>

  <h2 id="personnages">Personnages des sciences</h2>
  <ul class="gloss-index">
    {personnages.map((e) => (
      <li>
        <a href={`${base}/glossaire/${e.slug}/`}>{e.fr}</a> — {e.brefFr}
      </li>
    ))}
  </ul>

  <h2 id="videos">Ressources vidéo</h2>
  <div class="gloss-videos">
    {ressources.videos.map((video) => <div class="resource-entry">
      <VideoEmbed id={video.id} playlistId={video.playlistId} title={video.title} />
      <p class="resource-uses"><strong>Utilisée dans :</strong> {video.usages.map((usage, index) => <>{index > 0 && " · "}<a href={`${base}${usage.href}`}>{usage.title}</a></>)}</p>
    </div>)}
  </div>

  <h2 id="ressources">Autres ressources externes</h2>
  <ul class="gloss-index resources-list">
    {ressources.links.map((resource) => <li><a href={resource.url} rel="external noopener">{resource.title}</a><span class="resource-uses"> — utilisée dans {resource.usages.map((usage, index) => <>{index > 0 && ", "}<a href={`${base}${usage.href}`}>{usage.title}</a></>)}</span></li>)}
  </ul>
</Reading>

<style>
  .gloss-index { display: grid; gap: var(--space-2); padding-left: 1.2em; }
  .gloss-index em { color: var(--color-text-muted, inherit); }
  .gloss-nav { position: sticky; top: 5rem; z-index: 2; display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-5); padding: var(--space-2); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); box-shadow: var(--shadow-1); }
  .gloss-nav a { padding: var(--space-1) var(--space-2); }
  .gloss-videos { display: grid; gap: var(--space-4); }
  .resources-list a { overflow-wrap: anywhere; }
  .resource-uses { max-width: none; margin-top: var(--space-2); color: var(--color-text-muted); font-size: var(--text-sm); }
</style>
