---
import { getCollection, render } from "astro:content";
import Reading from "../../layouts/Reading.astro";
import { mdxComponents } from "../../components/mdx";
import { GLOSSAIRE } from "../../data/glossaire.mjs";
import { wikiUrl, wikiImg } from "../../data/glossaire-wiki.mjs";
import { glossaryMentions } from "../../lib/content-index.mjs";

/* FICHE DU GLOSSAIRE — la page complète d'une entrée. Le contenu long est
   FACULTATIF (collection glossaire) : sans fiche MDX, la page affiche le
   bref — chaque entrée a donc une page dès sa déclaration dans la source
   unique (src/data/glossaire.mjs). */
export async function getStaticPaths() {
  return GLOSSAIRE.map((e) => ({ params: { slug: e.slug }, props: { entry: e } }));
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const fiches = await getCollection("glossaire", ({ id, data }) => id === entry.slug && !data.draft);
const fiche = fiches[0];
const Content = fiche ? (await render(fiche)).Content : null;
// Modules (« enseigné dans ») — le lien inter-modules systématique.
const coursIds = Array.isArray(entry.cours) ? entry.cours : entry.cours ? [entry.cours] : [];
const cours = await getCollection("cours", ({ id }) => coursIds.includes(id));
const contenus = [
  ...await getCollection("cours", ({ id, data }) => !id.startsWith("en/") && !data.draft),
  ...await getCollection("miscelanea", ({ id, data }) => !id.startsWith("en/") && !data.draft),
];
const citations = glossaryMentions(entry, contenus, "fr");
const badges = [
  entry.type === "personnage" ? "Personnage" : "Terme",
  ...(entry.angl ? ["Anglicisme"] : []),
];
const corresp =
  entry.en.toLowerCase() !== entry.fr.toLowerCase() ? `En anglais : ${entry.en}.` : "";
const wiki = wikiUrl(entry.slug, "fr");
/* Portrait AFFICHÉ DEPUIS Wikimedia Commons — exception assumée à la règle
   « aucune ressource externe » (décision auteur) ; repli silencieux onerror. */
const img = entry.type === "personnage" ? wikiImg(entry.slug, 320) : undefined;
---
<Reading
  title={entry.fr}
  description={entry.brefFr}
  crumb={{ href: `${base}/glossaire/`, label: "glossaire" }}
  badges={badges}
  lead={`${entry.brefFr}${corresp ? ` ${corresp}` : ""}`}
  locale="fr"
  altUrl={`${base}/en/glossaire/${entry.slug}/`}
>
  {img && (
    <figure class="gloss-portrait">
      <img src={img} alt={`Portrait : ${entry.fr}`} loading="lazy" referrerpolicy="no-referrer" width="200" onerror="this.closest('figure').hidden = true" />
      <figcaption>Image : Wikimedia Commons</figcaption>
    </figure>
  )}
  {Content ? <Content components={mdxComponents} /> : null}
  {citations.length > 0 && <section class="gloss-citations" aria-labelledby="cite-dans">
    <h2 id="cite-dans">Cité dans le site</h2>
    <ul>{citations.map((item) => <li><a href={`${base}/${item.collection === "cours" ? "cours" : "miscelanea"}/${item.id}/`}>{item.data.title}</a></li>)}</ul>
  </section>}
  <p class="gloss-fiche__liens">
    {cours.length > 0 && (
      <span>Notion enseignée dans : {cours.map((c, i) => (
        <>{i > 0 && " · "}<a href={`${base}/cours/${c.id}/`}>{c.data.title}</a></>
      ))}.{" "}</span>
    )}
    {wiki && <a href={wiki} rel="external noopener">Lire sur Wikipédia ↗</a>}
  </p>
</Reading>

<style>
  .gloss-fiche__liens { margin-top: var(--space-5); font-size: var(--text-sm); }
  .gloss-citations { clear: both; }
  .gloss-portrait { float: right; margin: 0 0 var(--space-3) var(--space-4); max-width: 12rem; }
  .gloss-portrait img { max-width: 100%; border-radius: var(--radius-md); border: 1px solid var(--color-border); }
  .gloss-portrait figcaption { font-size: var(--text-xs); color: var(--color-text-muted, inherit); }
  @media (max-width: 40rem) { .gloss-portrait { float: none; margin: 0 0 var(--space-3); } }
  @media print { .gloss-portrait { display: none; } }
</style>
