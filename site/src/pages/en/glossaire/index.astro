---
import Reading from "../../../layouts/Reading.astro";
import { getCollection } from "astro:content";
import VideoEmbed from "../../../components/VideoEmbed.astro";
import { GLOSSAIRE } from "../../../data/glossaire.mjs";
import { contentResources, glossaryMentions } from "../../../lib/content-index.mjs";

/* GLOSSARY INDEX (EN) — generated from the single source of truth
   (src/data/glossaire.mjs), like the FR page. */
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const coll = new Intl.Collator("en");
const termes = GLOSSAIRE.filter((e) => e.type === "terme").sort((a, b) => coll.compare(a.en, b.en));
const personnages = GLOSSAIRE.filter((e) => e.type === "personnage").sort((a, b) =>
  coll.compare(a.en.split(" ").at(-1) ?? a.en, b.en.split(" ").at(-1) ?? b.en),
);
const contents = await getCollection("cours", ({ id, data }) => id.startsWith("en/") && !data.draft);
const articles = await getCollection("miscelanea", ({ id, data }) => id.startsWith("en/") && !data.draft);
const publishedContent = [...contents, ...articles];
const resources = contentResources(publishedContent);
const citationsBySlug = new Map(GLOSSAIRE.map((entry) => [entry.slug, glossaryMentions(entry, publishedContent, "en")]));
---
<Reading
  title="Glossary"
  description="Technical terms, borrowed terms and figures of science: the brief definitions weaving through every course on this site."
  crumb={{ href: `${base}/en/`, label: "home" }}
  lead="Every entry weaves through the courses: while reading, the first occurrence of a term is underlined — hover for the brief definition, click for the full entry. Borrowed terms carry their French ↔ English correspondence."
  locale="en"
  altUrl={`${base}/glossaire/`}
>
  <nav class="gloss-nav" aria-label="Glossary sections">
    <a href="#terms">Terms</a><a href="#figures">People</a><a href="#videos">Videos</a><a href="#resources">External resources</a>
  </nav>
  <h2 id="terms">Technical terms</h2>
  <ul class="gloss-index">
    {termes.map((e) => (
      <li>
        <a href={`${base}/en/glossaire/${e.slug}/`}>{e.en}</a>
        {e.en.toLowerCase() !== e.fr.toLowerCase() && <em> · fr&nbsp;: {e.fr}</em>}
        — {e.brefEn}
        {(citationsBySlug.get(e.slug)?.length ?? 0) > 0 && <span class="resource-uses"> — cited in {citationsBySlug.get(e.slug)?.map((item, index) => <>{index > 0 && ", "}<a href={`${base}/en/${item.collection === "cours" ? "cours" : "miscelanea"}/${item.id.slice(3)}/`}>{item.data.title}</a></>)}</span>}
      </li>
    ))}
  </ul>

  <h2 id="figures">Figures of science</h2>
  <ul class="gloss-index">
    {personnages.map((e) => (
      <li>
        <a href={`${base}/en/glossaire/${e.slug}/`}>{e.en}</a> — {e.brefEn}
        {(citationsBySlug.get(e.slug)?.length ?? 0) > 0 && <span class="resource-uses"> — cited in {citationsBySlug.get(e.slug)?.map((item, index) => <>{index > 0 && ", "}<a href={`${base}/en/${item.collection === "cours" ? "cours" : "miscelanea"}/${item.id.slice(3)}/`}>{item.data.title}</a></>)}</span>}
      </li>
    ))}
  </ul>

  <h2 id="videos">Video resources</h2>
  <div class="gloss-videos">
    {resources.videos.map((video) => <div class="resource-entry">
      <VideoEmbed id={video.id} playlistId={video.playlistId} title={video.title} />
      <p class="resource-uses"><strong>Used in:</strong> {video.usages.map((usage, index) => <>{index > 0 && " · "}<a href={`${base}${usage.href}`}>{usage.title}</a></>)}</p>
    </div>)}
  </div>

  <h2 id="resources">Other external resources</h2>
  <ul class="gloss-index resources-list">
    {resources.links.map((resource) => <li><a href={resource.url} rel="external noopener">{resource.title}</a><span class="resource-uses"> — used in {resource.usages.map((usage, index) => <>{index > 0 && ", "}<a href={`${base}${usage.href}`}>{usage.title}</a></>)}</span></li>)}
  </ul>
</Reading>

<style>
  .gloss-index { display: grid; gap: var(--space-2); padding-left: 1.2em; }
  .gloss-index em { color: var(--color-text-muted, inherit); }
  .gloss-nav { position: sticky; top: 5rem; z-index: 2; display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-5); padding: var(--space-2); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); box-shadow: var(--shadow-1); }
  .gloss-nav a { padding: var(--space-1) var(--space-2); }
  .gloss-videos { display: grid; gap: var(--space-4); }
  .resources-list a { overflow-wrap: anywhere; }
  .resource-uses { max-width: none; margin-top: var(--space-2); color: var(--color-text-muted); font-size: var(--text-sm); }
</style>
