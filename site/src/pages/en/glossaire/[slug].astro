---
import { getCollection, render } from "astro:content";
import Reading from "../../../layouts/Reading.astro";
import { mdxComponents } from "../../../components/mdx";
import { GLOSSAIRE } from "../../../data/glossaire.mjs";
import { wikiUrl, wikiImg } from "../../../data/glossaire-wiki.mjs";
import { glossaryMentions } from "../../../lib/content-index.mjs";

/* GLOSSARY ENTRY PAGE (EN) — long-form content is OPTIONAL (glossaire
   collection, en/ subfolder); without it the page falls back to the brief. */
export async function getStaticPaths() {
  return GLOSSAIRE.map((e) => ({ params: { slug: e.slug }, props: { entry: e } }));
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const fiches = await getCollection("glossaire", ({ id, data }) => id === `en/${entry.slug}` && !data.draft);
const fiche = fiches[0];
const Content = fiche ? (await render(fiche)).Content : null;
const coursIds = (Array.isArray(entry.cours) ? entry.cours : entry.cours ? [entry.cours] : []).map((c) => `en/${c}`);
const cours = await getCollection("cours", ({ id }) => coursIds.includes(id));
const contents = [
  ...await getCollection("cours", ({ id, data }) => id.startsWith("en/") && !data.draft),
  ...await getCollection("miscelanea", ({ id, data }) => id.startsWith("en/") && !data.draft),
];
const citations = glossaryMentions(entry, contents, "en");
const badges = [
  entry.type === "personnage" ? "Figure" : "Term",
  ...(entry.angl ? ["Borrowed term"] : []),
];
const corresp = entry.en.toLowerCase() !== entry.fr.toLowerCase() ? `French: ${entry.fr}.` : "";
const wiki = wikiUrl(entry.slug, "en");
/* Portrait served FROM Wikimedia Commons — a deliberate exception to the
   "no external resources" rule (author's decision); silent onerror fallback. */
const img = entry.type === "personnage" ? wikiImg(entry.slug, 320) : undefined;
---
<Reading
  title={entry.en}
  description={entry.brefEn}
  crumb={{ href: `${base}/en/glossaire/`, label: "glossary" }}
  badges={badges}
  lead={`${entry.brefEn}${corresp ? ` ${corresp}` : ""}`}
  locale="en"
  altUrl={`${base}/glossaire/${entry.slug}/`}
>
  {img && (
    <figure class="gloss-portrait">
      <img src={img} alt={`Portrait: ${entry.en}`} loading="lazy" referrerpolicy="no-referrer" width="200" onerror="this.closest('figure').hidden = true" />
      <figcaption>Image: Wikimedia Commons</figcaption>
    </figure>
  )}
  {Content ? <Content components={mdxComponents} /> : null}
  {citations.length > 0 && <section class="gloss-citations" aria-labelledby="cited-in">
    <h2 id="cited-in">Cited on this site</h2>
    <ul>{citations.map((item) => <li><a href={`${base}/en/${item.collection === "cours" ? "cours" : "miscelanea"}/${item.id.slice(3)}/`}>{item.data.title}</a></li>)}</ul>
  </section>}
  <p class="gloss-fiche__liens">
    {cours.length > 0 && (
      <span>Concept taught in: {cours.map((c, i) => (
        <>{i > 0 && " · "}<a href={`${base}/en/cours/${c.id.slice(3)}/`}>{c.data.title}</a></>
      ))}.{" "}</span>
    )}
    {wiki && <a href={wiki} rel="external noopener">Read on Wikipedia ↗</a>}
  </p>
</Reading>

<style>
  .gloss-fiche__liens { margin-top: var(--space-5); font-size: var(--text-sm); }
  .gloss-citations { clear: both; }
  .gloss-portrait { float: right; margin: 0 0 var(--space-3) var(--space-4); max-width: 12rem; }
  .gloss-portrait img { max-width: 100%; border-radius: var(--radius-md); border: 1px solid var(--color-border); }
  .gloss-portrait figcaption { font-size: var(--text-xs); color: var(--color-text-muted, inherit); }
  @media (max-width: 40rem) { .gloss-portrait { float: none; margin: 0 0 var(--space-3); } }
  @media print { .gloss-portrait { display: none; } }
</style>
