---
/**
 * DOCK — lanceur direct du terminal dans l'en-tête.
 * Le comportement de la fenêtre et les deux terminaux réels vivent dans
 * src/scripts/dock.js : VM Alpine locale ou compagnon connecté à un PTY.
 */
import Icon from "./Icon.astro";

interface Props {
  locale?: "fr" | "en";
}
const { locale = "fr" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const T = {
  fr: { terminal: "Ouvrir le terminal", grow: "Agrandir", fs: "Plein écran", min: "Minimiser", close: "Fermer" },
  en: { terminal: "Open the terminal", grow: "Enlarge", fs: "Full screen", min: "Minimise", close: "Close" },
}[locale];
---
<div class="dock" data-dock-context="idle">
  <button class="dock__trigger dock__terminal-trigger" type="button" data-dock-app="terminal" aria-pressed="false" aria-label={T.terminal} title={T.terminal}>
    <Icon name="square-terminal" class="dock__trigger-icon" />
  </button>
  <button class="dock__opts" type="button" data-dock-opts="terminal" aria-expanded="false" aria-label={locale === "en" ? "Choose the terminal mode" : "Choisir le mode du terminal"}>
    <Icon name="ellipsis-vertical" />
  </button>
</div>

{/* Fenêtre du dock pré-rendue ; dock.js y câble la VM ou le compagnon. */}
<div class="dockwin" data-dock-window="terminal" hidden>
  <div class="dockwin__bar" data-dockwin-bar>
    <Icon name="square-terminal" class="dockwin__icon" />
    <span class="dockwin__title"><span data-lang="fr">Terminal</span><span data-lang="en">Terminal</span></span>
    <span class="dockwin__mode" data-term-mode-label></span>
    <button class="dockwin__tool" data-dockwin-grow type="button" aria-label={T.grow} title={T.grow}>+</button>
    <button class="dockwin__tool" data-dockwin-fs type="button" aria-pressed="false" aria-label={T.fs} title={T.fs}><Icon name="expand" /></button>
    <button class="dockwin__tool" data-dockwin-min type="button" aria-label={T.min} title={T.min}><Icon name="minus" /></button>
    <button class="dockwin__tool" data-dockwin-close type="button" aria-label={T.close} title={T.close}><Icon name="x" /></button>
  </div>
  <div class="dockwin__body">
    {/* Hôte unique déplacé entre la colonne d’un cours et la fenêtre flottante. */}
    <div class="term-host" data-term-host>
    <div class="alpine-vm" data-term-pane="alpine">
      <div class="alpine-vm__loader" data-alpine-loader>
        <button type="button" data-alpine-start><span data-lang="fr">Démarrer Alpine</span><span data-lang="en">Start Alpine</span></button>
        <progress data-alpine-progress value="0" max="100"></progress>
        <span data-alpine-status role="status"><span data-lang="fr">L’image sera téléchargée une fois puis mise en cache.</span><span data-lang="en">The image will be downloaded once, then cached.</span></span>
      </div>
      <div data-alpine-screen aria-label={locale === "en" ? "Alpine virtual machine terminal" : "Terminal de la machine virtuelle Alpine"}></div>
    </div>
    <div class="alpine-vm" data-term-pane="debian" hidden>
      <div class="alpine-vm__loader" data-debian-loader>
        <button type="button" data-debian-start><span data-lang="fr">Démarrer Debian</span><span data-lang="en">Start Debian</span></button>
        <progress data-debian-progress value="0" max="100"></progress>
        <span data-debian-status role="status"><span data-lang="fr">L’image minimale sera téléchargée une fois puis mise en cache.</span><span data-lang="en">The minimal image will be downloaded once, then cached.</span></span>
      </div>
      <div data-debian-screen aria-label={locale === "en" ? "Debian virtual machine terminal" : "Terminal de la machine virtuelle Debian"}></div>
    </div>
    <div class="companion" data-term-pane="companion" hidden>
      <div class="companion__setup">
        <label for="companion-url"><span data-lang="fr">Adresse d’appairage</span><span data-lang="en">Pairing address</span></label>
        <div class="companion__connect">
          <input id="companion-url" data-companion-url type="url" spellcheck="false" autocomplete="off" placeholder="wss://localhost:43827/?token=…" />
          <button type="button" data-companion-connect><span data-lang="fr">Connecter</span><span data-lang="en">Connect</span></button>
        </div>
        <p data-companion-status role="status"><span data-lang="fr">Lancez le compagnon local, puis collez son adresse.</span><span data-lang="en">Start the local companion, then paste its address.</span></p>
        <p><a href={`${base}/${locale === "en" ? "en/" : ""}terminal/`}><span data-lang="fr">Voir la recette d’installation</span><span data-lang="en">View the installation guide</span></a></p>
      </div>
      <div class="companion__terminal" data-companion-terminal hidden>
        <div data-companion-screen aria-label={locale === "en" ? "Connected interactive terminal" : "Terminal interactif connecté"}></div>
      </div>
    </div>
    </div>
  </div>
  <span class="dockwin__resize" data-dockwin-resize aria-hidden="true"></span>
</div>
