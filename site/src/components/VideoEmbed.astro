---
/** Lecteur YouTube embarqué, à la largeur de sa colonne. */
interface Props {
  /** Identifiant strict d'une vidéo, ou identifiant d'une playlist. */
  id?: string;
  playlistId?: string;
  /** Titre accessible de la vidéo. */
  title: string;
}

const { id, playlistId, title } = Astro.props;
if ((id ? 1 : 0) + (playlistId ? 1 : 0) !== 1) {
  throw new Error("VideoEmbed: fournissez exactement `id` ou `playlistId`");
}
if (id && !/^[A-Za-z0-9_-]{11}$/.test(id)) {
  throw new Error(`VideoEmbed: identifiant YouTube invalide « ${id} »`);
}
if (playlistId && !/^[A-Za-z0-9_-]+$/.test(playlistId)) {
  throw new Error(`VideoEmbed: identifiant de playlist YouTube invalide « ${playlistId} »`);
}
const src = id
  ? `https://www.youtube-nocookie.com/embed/${id}?rel=0`
  : `https://www.youtube-nocookie.com/embed/videoseries?list=${playlistId}`;
---

<figure class="video-embed" data-video-id={id} data-playlist-id={playlistId}>
  <figcaption>{title}</figcaption>
  <iframe
    src={src}
    title={title}
    loading="lazy"
    referrerpolicy="strict-origin-when-cross-origin"
    allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen
    sandbox="allow-scripts allow-same-origin allow-presentation"
  ></iframe>
</figure>

<style>
  .video-embed {
    margin: var(--space-5) 0;
    width: 100%;
    box-sizing: border-box;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    overflow: hidden;
  }
  figcaption { padding: var(--space-2) var(--space-4); border-bottom: 1px solid var(--color-border); font-weight: 700; }
  iframe { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; }
  @media print { iframe { display: none; } }
</style>
