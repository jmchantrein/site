---
/** Lecteur YouTube embarqué, à la largeur de sa colonne, avec plein écran local. */
import Icon from "./Icon.astro";
interface Props {
  /** Identifiant strict d'une vidéo, ou identifiant d'une playlist. */
  id?: string;
  playlistId?: string;
  /** Titre accessible de la vidéo. */
  title: string;
}

const { id, playlistId, title } = Astro.props;
if ((id ? 1 : 0) + (playlistId ? 1 : 0) !== 1) {
  throw new Error("VideoEmbed: fournissez exactement `id` ou `playlistId`");
}
if (id && !/^[A-Za-z0-9_-]{11}$/.test(id)) {
  throw new Error(`VideoEmbed: identifiant YouTube invalide « ${id} »`);
}
if (playlistId && !/^[A-Za-z0-9_-]+$/.test(playlistId)) {
  throw new Error(`VideoEmbed: identifiant de playlist YouTube invalide « ${playlistId} »`);
}
const src = id
  ? `https://www.youtube-nocookie.com/embed/${id}?rel=0`
  : `https://www.youtube-nocookie.com/embed/videoseries?list=${playlistId}`;
---

<figure class="video-embed" data-video-id={id} data-playlist-id={playlistId}>
  <figcaption>
    <span>{title}</span>
    <button class="video-embed__fullscreen" type="button" data-video-fullscreen aria-label={`Afficher « ${title} » en plein écran`} title="Plein écran">
      <Icon name="expand" />
      <span data-lang="fr">Plein écran</span><span data-lang="en">Full screen</span>
    </button>
  </figcaption>
  <iframe
    src={src}
    title={title}
    loading="lazy"
    referrerpolicy="strict-origin-when-cross-origin"
    allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen
    sandbox="allow-scripts allow-same-origin allow-presentation"
  ></iframe>
</figure>

<script>
  document.querySelectorAll("[data-video-fullscreen]").forEach((button) => {
    if (button.getAttribute("data-ready")) return;
    button.setAttribute("data-ready", "true");
    button.addEventListener("click", () => {
      const frame = button.closest(".video-embed");
      if (frame?.requestFullscreen) frame.requestFullscreen();
    });
  });
</script>

<style>
  .video-embed {
    margin: var(--space-5) 0;
    width: 100%;
    box-sizing: border-box;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    overflow: hidden;
  }
  figcaption { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); padding: var(--space-2) var(--space-4); border-bottom: 1px solid var(--color-border); font-weight: 700; }
  .video-embed__fullscreen { display: inline-flex; align-items: center; gap: var(--space-2); flex: none; padding: var(--space-1) var(--space-2); border: 1px solid var(--color-border-strong); border-radius: var(--radius-sm); background: var(--color-surface); cursor: pointer; font-size: var(--text-xs); }
  .video-embed__fullscreen:hover { border-color: var(--color-accent); color: var(--color-accent-text); }
  .video-embed__fullscreen :global(svg) { width: 1rem; height: 1rem; }
  .video-embed:fullscreen { display: grid; align-content: center; width: 100vw; height: 100vh; border: 0; border-radius: 0; background: #000; }
  .video-embed:fullscreen figcaption { background: var(--color-surface); }
  .video-embed:fullscreen iframe { width: 100vw; max-height: calc(100vh - 3rem); }
  iframe { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; }
  @media print { iframe { display: none; } }
</style>
