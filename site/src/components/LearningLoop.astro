---
/** Schéma statique conservé pour la compatibilité des contenus MDX existants. */
import { pageLocale } from "../lib/locale";

const locale = pageLocale(Astro.url);
const copy = locale === "en"
  ? {
      title: "A learning loop with AI",
      steps: ["Attempt", "Ask for guidance", "Recall without help", "Verify and explain"],
    }
  : {
      title: "Une boucle d’apprentissage avec l’IA",
      steps: ["Essayer", "Demander un guidage", "Rappeler sans aide", "Vérifier et expliquer"],
    };
---

<figure class="learning-loop">
  <figcaption>{copy.title}</figcaption>
  <ol>
    {copy.steps.map((step, index) => <li><span aria-hidden="true">{index + 1}</span>{step}</li>)}
  </ol>
</figure>

<style>
  .learning-loop { margin: var(--space-5) 0; }
  figcaption { margin-bottom: var(--space-3); font-weight: 700; }
  ol { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: var(--space-3); padding: 0; list-style: none; }
  li { display: flex; align-items: center; gap: var(--space-2); padding: var(--space-3); border: 1px solid var(--color-border); border-radius: var(--radius-md); }
  span { display: grid; flex: 0 0 2rem; width: 2rem; height: 2rem; place-items: center; border-radius: 50%; background: var(--color-surface-raised); font-weight: 700; }
</style>
