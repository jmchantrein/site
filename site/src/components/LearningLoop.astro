---
import { pageLocale } from "../lib/locale";

const lang = pageLocale(Astro.url);
const steps = lang === "fr"
  ? [
      ["1", "Formuler", "But, niveau, contraintes"],
      ["2", "Produire", "Une explication ou un exercice"],
      ["3", "Rappeler", "Répondre sans regarder"],
      ["4", "Vérifier", "Comparer, sourcer, corriger"],
    ]
  : [
      ["1", "Frame", "Goal, level, constraints"],
      ["2", "Generate", "An explanation or exercise"],
      ["3", "Recall", "Answer without looking"],
      ["4", "Verify", "Compare, source, correct"],
    ];
const title = lang === "fr" ? "La boucle d’apprentissage avec une IA" : "The AI-assisted learning loop";
---

<figure class="learning-loop" aria-labelledby="learning-loop-title">
  <figcaption id="learning-loop-title">{title}</figcaption>
  <ol>
    {steps.map(([number, label, detail]) => (
      <li>
        <span class="step-number" aria-hidden="true">{number}</span>
        <span><strong>{label}</strong><small>{detail}</small></span>
      </li>
    ))}
  </ol>
</figure>

<style>
  .learning-loop {
    margin: 0;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  figcaption {
    margin-bottom: var(--space-4);
    color: var(--color-text-strong);
    font-weight: 700;
  }

  ol {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    gap: var(--space-3);
    align-items: center;
  }

  li:not(:last-child)::after {
    content: "↓";
    grid-column: 1;
    justify-self: center;
    color: var(--color-accent);
    line-height: 1;
  }

  .step-number {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  strong, small { display: block; }
  small { margin-top: .15rem; color: var(--color-text-muted); }
</style>
