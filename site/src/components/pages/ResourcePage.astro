---
import { render, type CollectionEntry } from "astro:content";
import Reading from "../../layouts/Reading.astro";
import VideoEmbed from "../VideoEmbed.astro";
import Icon from "../Icon.astro";
import Img from "../Img.astro";
import WikiImage from "../WikiImage.astro";
import { mdxComponents } from "../mdx";
import { resourceKindLabel } from "../../data/resources";
import { topicLabel } from "../../data/topics";

interface Props {
  entry: CollectionEntry<"ressources">;
  entries: CollectionEntry<"ressources">[];
  locale?: "fr" | "en";
  hasAlternate: boolean;
}
const { entry, entries, locale = "fr", hasAlternate } = Astro.props;
const { Content, headings } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const cpfx = locale === "en" ? `${base}/en` : base;
const slug = locale === "en" ? entry.id.slice(3) : entry.id;
const d = entry.data;
const idOf = (item: CollectionEntry<"ressources">) => locale === "en" ? item.id.slice(3) : item.id;
const byId = new Map(entries.map((item) => [idOf(item), item]));
const parentIds = [d.channel, ...d.playlists].filter(Boolean) as string[];
const parents = parentIds.map((id) => byId.get(id)).filter(Boolean) as CollectionEntry<"ressources">[];
const children = entries.filter((item) => item.data.channel === slug || item.data.playlists.includes(slug));
const relatedIds = new Set(d.related);
for (const item of entries) if (item.data.related.includes(slug)) relatedIds.add(idOf(item));
const related = [...relatedIds].map((id) => byId.get(id)).filter(Boolean) as CollectionEntry<"ressources">[];
const hasBody = Boolean(entry.body?.trim());
const toc = headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text }));
const languageNames = d.languages.map((code) => {
  try { return new Intl.DisplayNames([locale], { type: "language" }).of(code) ?? code; }
  catch { return code.toUpperCase(); }
});
const dateLabel = d.added.toLocaleDateString(locale === "en" ? "en-US" : "fr-FR", { year: "numeric", month: "long", day: "numeric" });
const resourceHref = (item: CollectionEntry<"ressources">) => `${cpfx}/explorer/${idOf(item)}/`;
const badges = [resourceKindLabel(d.kind, locale), ...languageNames, ...(d.duration ? [`≈ ${d.duration} min`] : [])];
---
<Reading
  title={d.title}
  description={d.summary ?? `${resourceKindLabel(d.kind, locale)} — ${d.title}`}
  crumb={{ href: `${cpfx}/explorer/`, label: locale === "en" ? "Recommendations" : "Recommandations" }}
  badges={badges}
  topics={d.topics.map((topic) => topicLabel(topic, locale))}
  lead={d.summary}
  toc={toc}
  locale={locale}
  altUrl={hasAlternate ? (locale === "en" ? `${base}/explorer/${slug}/` : `${base}/en/explorer/${slug}/`) : undefined}
  prev={{ href: `${cpfx}/explorer/`, label: locale === "en" ? "All recommendations" : "Toutes les recommandations" }}
>
  <dl class="resource-facts">
    <div><dt>{locale === "en" ? "Added" : "Ajoutée"}</dt><dd>{dateLabel}</dd></div>
    {d.year && <div><dt>{locale === "en" ? "Published" : "Publication"}</dt><dd>{d.year}</dd></div>}
    <div><dt>{locale === "en" ? "Language" : "Langue"}</dt><dd>{languageNames.join(", ")}</dd></div>
  </dl>

  {d.image && <Img src={d.image.src} alt={d.image.alt} caption={d.image.caption} />}
  {d.wikiImage && <WikiImage file={d.wikiImage.file} alt={d.wikiImage.alt} caption={d.wikiImage.caption} width={d.wikiImage.width} />}

  {d.youtubeId && <VideoEmbed id={d.youtubeId} title={d.title} />}
  {d.playlistId && <VideoEmbed playlistId={d.playlistId} title={d.title} />}

  {d.links.length > 0 && (
    <section aria-labelledby="resource-links">
      <h2 id="resource-links">{locale === "en" ? "Access the resource" : "Accéder à la ressource"}</h2>
      <ul class="resource-links">
        {d.links.map((link) => <li><a href={link.url} rel="external noopener">{link.label} <Icon name="external-link" /></a></li>)}
      </ul>
    </section>
  )}

  {hasBody && (
    <section aria-labelledby="author-note">
      <h2 id="author-note">{locale === "en" ? "Why I recommend it" : "Pourquoi je la recommande"}</h2>
      <Content components={mdxComponents} />
    </section>
  )}

  {(parents.length > 0 || children.length > 0 || related.length > 0) && (
    <section aria-labelledby="resource-relations">
      <h2 id="resource-relations">{locale === "en" ? "Explore further" : "Poursuivre l’exploration"}</h2>
      {parents.length > 0 && <div class="relation-group"><h3>{locale === "en" ? "Part of" : "Fait partie de"}</h3><ul>{parents.map((item) => <li><a href={resourceHref(item)}>{item.data.title}</a> <small>{resourceKindLabel(item.data.kind, locale)}</small></li>)}</ul></div>}
      {children.length > 0 && <div class="relation-group"><h3>{locale === "en" ? "Selected here" : "Sélection associée"}</h3><ul>{children.map((item) => <li><a href={resourceHref(item)}>{item.data.title}</a> <small>{resourceKindLabel(item.data.kind, locale)}</small></li>)}</ul></div>}
      {related.length > 0 && <div class="relation-group"><h3>{locale === "en" ? "Related recommendations" : "Recommandations liées"}</h3><ul>{related.map((item) => <li><a href={resourceHref(item)}>{item.data.title}</a> <small>{resourceKindLabel(item.data.kind, locale)}</small></li>)}</ul></div>}
    </section>
  )}
</Reading>

<style>
  .resource-facts { display: flex; flex-wrap: wrap; gap: var(--space-3); margin: 0 0 var(--space-5); }
  .resource-facts div { min-width: 9rem; padding: var(--space-3); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface-sunken); }
  .resource-facts dt { color: var(--color-text-muted); font: 600 var(--text-xs)/1.3 var(--font-mono); text-transform: uppercase; letter-spacing: .05em; }
  .resource-facts dd { margin: var(--space-1) 0 0; }
  .resource-links { list-style: none; padding: 0; }
  .resource-links a { display: inline-flex; align-items: center; gap: var(--space-2); }
  .resource-links :global(svg) { width: 16px; height: 16px; }
  .relation-group small { margin-left: var(--space-2); color: var(--color-text-muted); }
</style>
